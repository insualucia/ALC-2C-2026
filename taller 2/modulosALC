def multiplicacionDeVectores(v1, v2):
  res = 0
  for i in range(v1.size):
    res = res + v1[i]*v2[i]
  return res

def multiplicacionDeMatrices(A,B):
    assert(A.shape[0] == B.shape[1])
    C = np.zeros([A.shape[1],B.shape[0]])
    for i in range(C.shape[0]):
      for j in range(C.shape[1]):
        C[i][j] = multiplicacionDeVectores(A[i],B[:,j])
    return C

